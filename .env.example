# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# MongoDB Connection URI (e.g., mongodb://localhost:27017/taskmanager or MongoDB Atlas URI)
# If not provided or if MongoDB is unreachable, the app automatically falls back
# to an embedded local data store so it runs instantly without configuration.
MONGODB_URI="mongodb://localhost:27017/taskmanager"

# JWT Secret Key for signing authentication tokens
JWT_SECRET="student_task_manager_secret_key_2026"

